<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Version>2.0.8</Version>
		<Authors>Joel Christner</Authors>
		<Description>RestDb is a platform that enables a RESTful API interface in front of Microsoft SQL Server, MySQL, PostgreSQL, and Sqlite databases.</Description>
		<Copyright>(c)2024 Joel Christner</Copyright>
		<PackageProjectUrl>https://github.com/jchristn/restdb</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jchristn/restdb</RepositoryUrl>
		<RepositoryType>Github</RepositoryType>
		<PackageTags>rest,database,api,db</PackageTags>
		<PackageReleaseNotes>Patch release: dependency refresh across all providers (Microsoft.Data.SqlClient 7.0.2, Microsoft.Data.Sqlite 10.0.11, MySqlConnector 2.6.2, Npgsql 10.0.3, Watson 7.1.0, SyslogLogging 2.2.1, Newtonsoft.Json 13.0.4, Inputty 1.0.13). Pins SQLitePCLRaw.bundle_e_sqlite3 3.0.5 (SQLite &gt;= 3.50.2) to resolve CVE-2025-6965. Adds symbol packages. No public API changes.</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageIconUrl></PackageIconUrl>
		<PublishWithAspNetCoreTargetManifest>false</PublishWithAspNetCoreTargetManifest>
		<PackageIcon>database-icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="assets\database-icon.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="LICENSE.md" Pack="true" PackagePath="" />
		<None Include="assets\database-icon.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="Dockerbuild.bat">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="Dockerfile">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="Dockerrun.bat">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="Dockerrun.sh">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="sample.db">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="sample.sql">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ExpressionTree" Version="1.1.2" />
		<PackageReference Include="Inputty" Version="1.0.13" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
		<!-- Pin the native SQLite bundle to a build that ships SQLite >= 3.50.2 to resolve CVE-2025-6965 (GHSA-2m69-gcr7-jv3q). -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
		<PackageReference Include="MySqlConnector" Version="2.6.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="SyslogLogging" Version="2.2.2" />
		<PackageReference Include="Watson" Version="7.2.0" />
	</ItemGroup>
</Project>
