{
  "Server": {
    "ListenerHostname": "*",
    "ListenerPort": 8000,
    "Ssl": false,
    "Debug": false,
    "RequireAuthentication": true,
    "ApiKeyHeader": "x-api-key"
  },
  "Logging": {
    "ServerIp": "127.0.0.1",
    "ServerPort": 514,
    "MinimumLevel": 1,
    "LogHttpRequests": false,
    "LogHttpResponses": false,
    "ConsoleLogging": true
  },
  "Telemetry": {
    "Enable": true,
    "ServiceName": "restdb",
    "OtlpEnable": true,
    "OtlpEndpoint": "http://tempo:4317",
    "OtlpProtocol": "grpc",
    "PrometheusEnable": true,
    "PrometheusHostname": "restdb",
    "PrometheusPort": 9464,
    "TraceSamplingRatio": 1.0
  },
  "Databases": [
    {
      "Name": "sample",
      "Type": "Sqlite",
      "Filename": "./sample.db",
      "Debug": false,
      "Tables": [],
      "TableNames": []
    }
  ],
  "ApiKeys": [
    {
      "Key": "default",
      "AllowGet": true,
      "AllowPost": true,
      "AllowPut": true,
      "AllowDelete": true
    }
  ]
}
