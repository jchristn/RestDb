{
  "uid": "restdb-mcp",
  "title": "RestDb / MCP",
  "description": "RestDb.McpServer: tool calls by tool, transport, and outcome; the RestDb API calls behind them; client connections; and the outbound HTTP connection pool.",
  "tags": [
    "restdb"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "restdb"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "RestDb dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "tool",
        "label": "Tool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(restdb_mcp_tool_calls_total, gen_ai_tool_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(restdb_mcp_tool_calls_total, gen_ai_tool_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
